# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> API
#
# Both values are safe in a browser bundle and therefore safe in this public
# repo's build output. The anon key is designed to be public; row-level security
# is what constrains it. See D-008 and D-004.
#
# NEVER put the service_role key here or anywhere else client-side. It bypasses
# RLS entirely. It belongs only in server-side contexts, of which this project
# currently has none.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
